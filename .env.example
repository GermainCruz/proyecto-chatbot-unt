# ============================================================
# UNT Bot — variables de entorno
# Copia este archivo como .env y ajusta los valores.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=untbot
POSTGRES_PASSWORD=untbot
POSTGRES_DB=untbot
# Puerto 5433 en el host (Docker mapea 5433→5432). Evita choque con PostgreSQL de Windows en 5432.
DATABASE_URL=postgresql+psycopg://untbot:untbot@localhost:5433/untbot

# ---- Backend (FastAPI) ----
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Modelo LLM y embeddings (OpenAI)
# Si dejas OPENAI_API_KEY vacío, el sistema funciona en MODO DEMO
# (respuestas heurísticas). Para calidad real, configura tu API key.
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Gemini recomendado (evita gemini-3-flash en tier gratis: cuota muy baja)
LLM_MODEL=gemini-2.0-flash
LLM_MODEL_FALLBACK=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
LLM_MAX_OUTPUT_TOKENS=8192

# Administrador inicial (se crea automáticamente al iniciar)
ADMIN_EMAIL=admin@unitru.edu.pe
ADMIN_PASSWORD=Admin1234*
ADMIN_NAME=Administrador UNT Bot

# ---- Frontend (Next.js) ----
# Desarrollo local con npm run dev: usa /api (proxy en next.config.mjs)
NEXT_PUBLIC_API_URL=/api
# Docker Compose (frontend en contenedor): http://localhost:8000/api
